        NIST["NIST AI RMF 1.0<br/>Risk Management Framework"]
        ISO27001["ISO 27001:2022<br/>Information Security"]
        EO["Executive Orders<br/>14110 / 14179"]
    end

    Standards --> Framework
    Framework --> Dimensions
    Dimensions --> Maturity
    Framework --> Tiers
    Framework --> ProfilesP
    ProfilesP -.-> Maturity
    ProfilesP -.-> Tiers
    L1 --> L2 --> L3 --> L4 --> L5
    B1 --> B2 --> B3

