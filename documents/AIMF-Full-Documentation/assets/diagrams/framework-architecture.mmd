        MAP["MAP<br/>19 Controls<br/>Context, Impact,<br/>Stakeholder, Third-Party"]
        MEASURE["MEASURE<br/>22 Controls<br/>Testing, TEVV,<br/>Trustworthiness"]
        MANAGE["MANAGE<br/>13 Controls<br/>Response, Monitoring,<br/>Improvement"]
    end

    subgraph Standards["Standards Foundation — Built on Internationally Recognized Standards"]
